generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  links     Link[]
  createdAt DateTime @default(now())
}

model Link {
  id           String          @id @default(uuid())
  name         String
  baseUrl      String
  redirectUrl  String?
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  parameters   LinkParameter[]
  createdAt    DateTime        @default(now())
}

model Parameter {
  id        String          @id @default(uuid())
  key       String
  value     String
  links     LinkParameter[]
  createdAt DateTime        @default(now())
}

model LinkParameter {
  linkId      String
  link        Link      @relation(fields: [linkId], references: [id])
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])

  @@id([linkId, parameterId])
}
